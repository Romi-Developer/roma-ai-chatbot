# ── API Keys (at least one required) ──────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get from https://console.groq.com/keys (FREE tier available)
GROQ_API_KEY=

# ── Ollama (local, free) ──────────────────────────────────────────
# Install from https://ollama.com then run: ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenRouter (optional — access many models via one API) ────────
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── App Config ────────────────────────────────────────────────────
# Comma-separated list of allowed origins (default: localhost)
ALLOWED_ORIGINS=http://localhost:3000
